NODE_ENV=development

# PostgreSQL (docker-compose default)
DATABASE_URL=postgres://sports:sports@127.0.0.1:5432/sports_prediction
DATABASE_MAX_POOL_SIZE=10
# If DATABASE_URL is set but unreachable, API/worker refuse to start.
# Set to true only for demos to fall back to the seeded in-memory store.
STORE_ALLOW_MEMORY_FALLBACK=false

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379
# The worker registers recurring jobs (see packages/shared/src/schedules.ts).
# Set to false to run the worker without cron (e.g. while debugging).
JOB_SCHEDULER_ENABLED=true

# API
PORT=3000
# Permitted CORS origins (comma-separated, or *). Empty = local dev origins
# (http://localhost:5173, http://localhost:3000, 127.0.0.1 equivalents).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Shared secret for /admin/*. Empty = open (local only).
# Prefer ADMIN_PASSWORD: the browser gets a 12h session and the secret stays
# on the server. ADMIN_TOKEN remains for scripts (header x-admin-token).
ADMIN_TOKEN=
ADMIN_PASSWORD=

# Frontend build-time variables (Vercel). Empty in local dev: Vite proxies /api.
# VITE_API_URL=https://your-api-host
# VITE_ADMIN_TOKEN=

# External sources (leave empty until configured)
API_FOOTBALL_KEY=
# Free plans only allow seasons 2022-2024; override if needed
API_FOOTBALL_SEASON=2024
# football-data.org token (free tier): current-season fixtures and results
FOOTBALL_DATA_KEY=

